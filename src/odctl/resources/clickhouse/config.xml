<?xml version="1.0"?>
<clickhouse>
    <max_connections>4096</max_connections>
    <keep_alive_timeout>64</keep_alive_timeout>
    <max_concurrent_queries>100</max_concurrent_queries>

    <uncompressed_cache_size>268435456</uncompressed_cache_size>
    <mark_cache_size>536870912</mark_cache_size>
    <background_pool_size>16</background_pool_size>
    <background_schedule_pool_size>8</background_schedule_pool_size>

    <!-- Docker networks hand out IPv6 addresses, and container names can resolve
         to the AAAA record only, so listening on IPv4 alone leaves peers with
         connection refused. :: is dual-stack and covers IPv4 too, so it comes
         first; the 0.0.0.0 entry is a fallback for hosts without IPv6, where
         the :: bind fails harmlessly thanks to listen_try. -->
    <listen_try>1</listen_try>
    <listen_host>::</listen_host>
    <listen_host>0.0.0.0</listen_host>

    <zookeeper>
        <node>
            <host>ch-keeper</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- Every replica carries credentials because the default user has a
         password. Without them a server-to-server connection authenticates as
         default with an empty password and fails with AUTHENTICATION_FAILED,
         which any distributed or parallel-replica read would hit as soon as it
         has to leave the local node. -->
    <remote_servers>
        <odctl_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>ch-11</host><port>9000</port><user>default</user><password>password</password></replica>
                <replica><host>ch-12</host><port>9000</port><user>default</user><password>password</password></replica>
            </shard>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>ch-21</host><port>9000</port><user>default</user><password>password</password></replica>
                <replica><host>ch-22</host><port>9000</port><user>default</user><password>password</password></replica>
            </shard>
        </odctl_cluster>

        <!-- Parallel replicas require a cluster of exactly one shard, so they
             cannot use odctl_cluster on any profile. This entry covers the
             single shard that ch-lite runs, and is what
             cluster_for_parallel_replicas should name. -->
        <odctl_single_shard>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>ch-11</host><port>9000</port><user>default</user><password>password</password></replica>
                <replica><host>ch-12</host><port>9000</port><user>default</user><password>password</password></replica>
            </shard>
        </odctl_single_shard>
    </remote_servers>

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>

    <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>

    <yandex>
        <logger>
            <level>warning</level>
            <log>/var/log/clickhouse-server/clickhouse-server.log</log>
            <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
            <size>1000M</size>
            <count>10</count>
            <console>1</console>
        </logger>
    </yandex>
</clickhouse>
