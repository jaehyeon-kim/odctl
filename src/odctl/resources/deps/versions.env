# Single source of truth for the versions the deps image builds against.
#
# Sourced by every fetch script and passed into the Gradle stage as build args,
# so a bump is one edit here rather than four in step. See issue #5.
#
# The one value that lives outside this file is the Flink runtime image tag in
# compose-flink.yml, which Docker Compose resolves before any of this runs. Keep
# its minor equal to FLINK_MINOR below.

# Flink minor series. Pinned to 2.1 because Iceberg publishes
# iceberg-flink-runtime for 2.0 and 2.1 only, and fluss-flink has no 2.0 build.
FLINK_MINOR=2.1

# Iceberg client libraries, shared by the Spark, Flink, and standalone fetches so
# every engine and the PyIceberg sidecar agree.
ICEBERG_V=1.11.0

# Hadoop client jars, used by the Gradle stage for the Flink classpath.
HADOOP_V=3.3.6

# Hadoop S3A for Spark. Iceberg's own reads and writes go through S3FileIO, but
# the remove_orphan_files and add_files procedures list and stage through
# Hadoop's FileSystem API, so they need hadoop-aws on the Spark classpath.
# Match the Hadoop that the pinned apache/spark image bundles, currently 3.4.2
# for the 4.1 series, and pin the AWS SDK to the version hadoop-aws declares
# rather than the newest published one. Spark 4.2.0 bundles Hadoop 3.5.0, so
# this value moves only when that image's minor does.
#
# The shaded `bundle` artifact is deliberate, despite being about 640 MB. Two
# slimmer attempts both failed: resolving hadoop-aws with `bundle` excluded plus
# the s3, sts and apache-client modules gives 17 MB but dies with
# NoSuchMethodError on io.netty.channel.SingleThreadEventLoop, because the SDK's
# async client pulls a Netty that clashes with the one Spark ships. Excluding
# Netty as well gives 13 MB and then dies with NoClassDefFoundError on
# software.amazon.awssdk.transfer.s3, because Hadoop 3.4's S3A needs the
# transfer manager, which needs that async client. Shading is what breaks the
# cycle, so use the bundle.
HADOOP_AWS_V=3.4.2
AWS_SDK_V=2.29.52
