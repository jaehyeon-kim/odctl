        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kafka_controller_kafkacontroller_value{job=\"kafka\",instance=~\"$instance\",name=\"ActiveControllerCount\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
