    {
      "id": 9,
      "type": "timeseries",
      "title": "Request latency percentiles",
      "description": "Latency percentiles from the request duration histogram, all requests. The histogram uses the default prometheus_client buckets, which end at 10 seconds. Counts only requests the Flask application handles. Routes MLflow serves with FastAPI directly (artifact upload and download, OTLP traces, jobs, gateway, assistant) are not counted, nor are /health, /version and /metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
