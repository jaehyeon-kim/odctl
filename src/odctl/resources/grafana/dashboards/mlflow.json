      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mlflow_http_request_duration_seconds_bucket{job=\"mlflow\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true
